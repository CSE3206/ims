{
  "name": "ims-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Inventory Management System API — Express + Drizzle ORM + Neon Postgres",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node src/index.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env src/db/seed.js",
    "test": "node --test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "ws": "^8.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
